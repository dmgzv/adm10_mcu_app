          <FlashDriverDll>UL2CM3(-S0 -C0 -P0 -FD20000000 -FC1000 -FN1 -FF0STM32F4xx_2048 -FS08000000 -FL0200000 -FP0($$Device:STM32F427ZITx$CMSIS\Flash\STM32F4xx_2048.FLM))</FlashDriverDll>
