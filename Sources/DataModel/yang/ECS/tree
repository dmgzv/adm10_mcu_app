module: ipg-ecs

  rpcs:
    +---x set-current-datetime
    |  +---w input
    |     +---w current-datetime    yang:date-and-time
    +---x get-current-datetime
    |  +--ro output
    |     +--ro current-datetime?   string
    +---x cc-reboot
       +---w input
          +---w cc-card    enumeration
module: ipg-hidden
  +--rw __HIDDEN__
     +--rw admin-state?     ipg-cmn:admin-state-type
     +--ro service-state?   ipg-cmn:service-state-type
module: ipg-log

  rpcs:
    +---x download-req
       +---w input
          +---w req-id            uint32
          +---w requester-ip      ipg-cmn:ipv4-address
          +---w log-type          log-type
          +---w record-index      uint32
          +---w count             uint32
          +---w server-details
             +---w ip-address       ipg-cmn:ipv4-address
             +---w port-num?        ipg-cmn:port-number
             +---w sftp-login       string
             +---w sftp-password    string
             +---w directory        string

  notifications:
    +---n new-log-notif
    |  +--ro log-type        log-type
    |  +--ro record-index    uint32
    |  +--ro log-record      string
    +---n download-status-notif
       +--ro req-id            uint32
       +--ro requester-ip      ipg-cmn:ipv4-address
       +--ro err-code          int32
       +--ro (download-status)?
          +--:(success)
          |  +--ro filename*   string
          +--:(failure)
             +--ro err-msg?    string
module: ipg-management

  rpcs:
    +---x backup
    |  +---w input
    |  |  +---w ip-address        ipg-cmn:ipv4-address
    |  |  +---w port-num?         ipg-cmn:port-number
    |  |  +---w sftp-login        string
    |  |  +---w sftp-password     string
    |  |  +---w file-path-name    string
    |  +--ro output
    |     +--ro err-msg?   string
    +---x restore
       +---w input
       |  +---w ip-address        ipg-cmn:ipv4-address
       |  +---w port-num?         ipg-cmn:port-number
       |  +---w sftp-login        string
       |  +---w sftp-password     string
       |  +---w file-path-name    string
       +--ro output
          +--ro err-msg?   string

  notifications:
    +---n invalid-schema
    |  +--ro err-msg?   string
    +---n startup-config-invalid
    |  +--ro err-msg?   string
    +---n sc-initial-config-error
    |  +--ro sc-slot-id?   uint8
    |  +--ro err-msg?      string
    +---n card-ready
       +--ro sc-slot-id?         uint8
       +--ro card-module-name?   ipg-cmn:string-64
module: ipg-software-update

  rpcs:
    +---x start-sw-update
    |  +---w input
    |  |  +---w slot-category     enumeration
    |  |  +---w slot-num          uint8
    |  |  +---w ip-address        ipg-cmn:ipv4-address
    |  |  +---w port-num?         ipg-cmn:port-number
    |  |  +---w sftp-login        string
    |  |  +---w sftp-password     string
    |  |  +---w file-path-name    string
    |  +--ro output
    |     +--ro status?         enumeration
    |     +--ro error-string?   string
    +---x get-sw-update-status
    |  +---w input
    |  |  +---w slot-category?   enumeration
    |  |  +---w slot-num?        uint8
    |  +--ro output
    |     +--ro status-update* [id]
    |        +--ro id               int32
    |        +--ro slot-category?   enumeration
    |        +--ro slot-num?        uint8
    |        +--ro status?          enumeration
    |        +--ro total-nstages?   int32
    |        +--ro current-stage?   string
    |        +--ro error-string?    string
    +---x cancel-sw-update
       +---w input
       |  +---w slot-category?   enumeration
       |  +---w slot-num?        uint8
       +--ro output
          +--ro cancel-resp* [id]
             +--ro id               int32
             +--ro slot-category?   enumeration
             +--ro slot-num?        uint8
             +--ro status?          enumeration
             +--ro error-string?    string
