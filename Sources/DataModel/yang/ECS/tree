module: ipg-users

  rpcs:
    +---x create-user
    |  +---w input
    |     +---w login-name    loginstr
    |     +---w password      passwdstr
    |     +---w user-role     roles
    |     +---w full-name?    namestr
    |     +---w e-mail?       emailstr
    |     +---w phone?        phonestr
    +---x update-user-details
    |  +---w input
    |     +---w login-name    loginstr
    |     +---w full-name?    namestr
    |     +---w e-mail?       emailstr
    |     +---w phone?        phonestr
    +---x update-user-password
    |  +---w input
    |     +---w login-name            loginstr
    |     +---w requester-password    passwdstr
    |     +---w new-password          passwdstr
    +---x delete-user
    |  +---w input
    |     +---w login-name    loginstr
    +---x get-user
    |  +---w input
    |  |  +---w login-name    loginstr
    |  +--ro output
    |     +--ro login-name?   loginstr
    |     +--ro user-role?    roles
    |     +--ro full-name?    namestr
    |     +--ro e-mail?       emailstr
    |     +--ro phone?        phonestr
    +---x get-users
       +--ro output
          +--ro users* [login-name]
             +--ro login-name    loginstr
             +--ro user-role?    roles
             +--ro full-name?    namestr
             +--ro e-mail?       emailstr
             +--ro phone?        phonestr
